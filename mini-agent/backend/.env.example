# Provider selection
AGENT_PROVIDER=openai_compat
AGENT_MODEL=grm2.6-plus
AGENT_LOGICAL_MODEL_ROUTE=grm2.6-plus
AGENT_ACTIVE_MODEL=tencent/hy3:free
AGENT_ENABLE_FALLBACK=true
AGENT_FALLBACK_PROVIDER=openai_compat
AGENT_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
AGENT_FALLBACK_API_KEY=replace_me
AGENT_FALLBACK_MODEL=tencent/hy3:free
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_TRANSPORT_BASE_URL=https://openrouter.ai/api/v1
AGENT_TRANSPORT_API_KEY=replace_me

# Anthropic-compatible credentials
# PROVIDER_ANTHROPIC_API_KEY=replace_me
# PROVIDER_ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI-compatible credentials (when AGENT_PROVIDER=openai_compat)
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_API_KEY=replace_me
# OPENAI_COMPAT_MODEL=tencent/hy3:free
# OPENAI_COMPAT_ENABLE_THINKING=false
# OPENAI_COMPAT_LOG_REQUESTS=true
# OPENAI_COMPAT_LOG_FULL_PAYLOAD=false
# OPENAI_COMPAT_MODEL_COMPAT_MODE=
# OPENAI_COMPAT_MODEL_COMPAT_MODE_MAP_JSON={"mirothinker":"xml_mcp_reasoning"}
# OPENAI_COMPAT_XML_MCP_ALLOWED_SERVERS=harness,polymorph,default,local,my-tools

# Active transport model aliases (legacy LiteLLM env names kept as catalog aliases)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=replace_me
# LLM_DEFAULT_MODEL=tencent/hy3:free
# LITELLM_MODEL_BASE_URL=https://openrouter.ai/api/v1
# LITELLM_API_KEY=replace_me
# LITELLM_MODEL_NAME=tencent/hy3:free
# LITELLM_MODEL_NAMES=tencent/hy3:free,grm2.6-plus

# Agent control knobs
MAX_AGENT_ITERATIONS=60
MAX_TOOL_CALLS_PER_ITERATION=12
MAX_TOOL_CALLS_PER_RUN=120
MAX_HISTORY_CHARS_FOR_MODEL=180000
AGENT_MAX_TOKENS=16384
AGENT_TEMPERATURE=1.0
STRICT_VERIFICATION_MODE=true
ENABLE_REPLAY_LOGS=true
DISABLED_TOOLS=
AGENT_REQUIRE_PLAN_FOR_PROJECTS=true
AGENT_PLAN_APPROVAL_MODE=manual
# AGENT_PLAN_APPROVAL_KEYWORDS=approve plan,plan approved,proceed with build
AGENT_SHELL_PROFILE=project
# AGENTS_RULES_PATH=/app/backend/AGENTS.md
# PYTHON_TOOL_MAX_TIMEOUT_SECONDS=180
# SHELL_TIMEOUT_SECONDS=60

# Prompt overrides
# SYSTEM_PROMPT_PATH=/app/backend/prompts/system_prompt.md
# TOOL_EVALUATION_PROMPT_PATH=/app/backend/prompts/tool_evaluation_prompt.md

# Runtime connection override storage
# RUNTIME_CONFIG_PATH=/app/backend/replays/runtime_config.json
# RUNTIME_CONFIG_KEY_PATH=/app/backend/replays/runtime_config.key
# RUNTIME_CONFIG_ENCRYPTION_KEY=   # optional Fernet key; if empty, a local key file is generated

# Voice services (optional)
# VOICE_AGENT_PROVIDER=openai_compat
# VOICE_AGENT_MODEL=omnicoder
# VOICE_AGENT_FALLBACK_MODEL=qwen3.5-9b
# VOICE_AGENT_MAX_TOKENS=512
# VOICE_AGENT_TEMPERATURE=0.6
# VOICE_REALTIME_TTS_API_KEY=replace_me
# VOICE_REALTIME_TTS_BASE_URL=https://asr.example.com
# VOICE_REALTIME_TTS_MODEL=kokoro_realtime
# VOICE_REALTIME_TTS_VOICE=af_heart
# VOICE_ALLOW_LEGACY_TTS_FALLBACK=false
#
# ASR_BASE_URL=https://asr.example.com
# ASR_API_KEY=replace_me
# ASR_MODEL=Systran/faster-whisper-large-v3
# ASR_TRANSCRIBE_PATH=/api/asr
# ASR_TIMEOUT_SECONDS=60
# ASR_HEALTH_TIMEOUT_SECONDS=3
# ASR_MAX_FILE_SIZE_BYTES=26214400
#
# TTS_BASE_URL=https://tts.example.com
# TTS_API_KEY=replace_me
# TTS_MODEL=kokoro_realtime
# TTS_TIMEOUT_SECONDS=60
#
# Direct multimodal audio model routing (optional)
# Use this when microphone audio should go directly to a multimodal chat model
# instead of being transcribed first.
# DIRECT_AUDIO_PROVIDER=openai_compat
# DIRECT_AUDIO_BASE_URL=https://openrouter.ai/api/v1
# DIRECT_AUDIO_API_KEY=replace_me
# DIRECT_AUDIO_MODEL=phi-4-instruct
# PHI_4_INSTRUCT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# PHI_4_INSTRUCT_API_KEY=replace_me
# PHI_4_INSTRUCT_MODEL_NAME=phi-4-instruct
#
# Delegated vision / Perceptor route (optional)
# Use this when the active chat model is text-first but visual inspection
# should route through local OCR first and a separate visual model when needed.
# VISION_ROUTING_MODE=auto
# VISION_LOCAL_OCR_ENABLED=true
# VISION_LOCAL_OCR_ENGINE=paddleocr
# VISION_LOCAL_OCR_TIMEOUT_SECONDS=20
# VISION_PADDLE_DET_DIR=/home/cory/.paddlex/official_models/PP-OCRv5_server_det
# VISION_PADDLE_REC_DIR=/home/cory/.paddlex/official_models/en_PP-OCRv5_mobile_rec
# VISION_PADDLE_DOC_ORI_DIR=/home/cory/.paddlex/official_models/PP-LCNet_x1_0_doc_ori
# VISION_PADDLE_TEXTLINE_ORI_DIR=/home/cory/.paddlex/official_models/PP-LCNet_x1_0_textline_ori
# VISION_PADDLE_UVDOC_DIR=/home/cory/.paddlex/official_models/UVDoc
# VISION_GLM_OCR_DIR=/home/cory/models/GLM-OCR
# AGENT_NATIVE_VISION_ENABLED=false
# VISION_AUTO_INSPECT=true
# VISION_AUTO_INSPECT_MAX_IMAGES=3
# VISION_PROVIDER=openai_compat
# VISION_BASE_URL=https://openrouter.ai/api/v1
# VISION_API_KEY=replace_me
# VISION_MODEL=xiaomi/mimo-v2.5
# VISION_MAX_TOKENS=1200
# VISION_VERIFY_PROVIDER=openai_compat
# VISION_VERIFY_BASE_URL=https://openrouter.ai/api/v1
# VISION_VERIFY_API_KEY=replace_me
# VISION_VERIFY_MODEL=openrouter/fusion
#
# Outreach / Profit Agent tooling (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_SSL=false
# SMTP_USE_STARTTLS=true
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=AetherPro Outreach
# EMAIL_SEND_ENABLED=false
# EMAIL_ALLOWED_DOMAIN_SUFFIXES=aetherpro.us,aetherpro.tech
# PROFIT_SCRAPE_TIMEOUT_SECONDS=25
# PROFIT_SCRAPER_USER_AGENT=AetherPro-Agent/1.0 (+https://aetherpro.us)
# PROFIT_SCRAPE_ALLOW_INSECURE_RETRY=true
# FIRECRAWL_API_KEY=replace_me
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# FIRECRAWL_TIMEOUT_SECONDS=60
# FIRECRAWL_ORIGIN=polymorph
# FIRECRAWL_ENABLE_FOR_SCRAPE_PAGE=true

# Memory backends (optional overrides)
# AGENT_ID=polymorph-agent
# MEMORY_AGENT_ID=polymorph-agent
# AGENT_NAME=PolyMorph
# MEMORY_NAMESPACE=polymorph
# REDIS_URL=redis://:replace_me@aether-redis:6379/0
# AETHER_MONGO_DB=aethercore
# AETHER_MONGO_URI=mongodb://user:pass@aether-mongo:27017/admin?authSource=admin
# POSTGRES_DSN=postgresql://user:pass@aether-postgres:5432/operations
# POSTGRES_SCHEMA=polymorph
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333
# QDRANT_API_KEY=
# NATS_MONITOR_URL=http://aether-nats:8222/healthz
# COLLABFABRIC_BASE_URL=http://collabfabric-collab-backend:8085
# PASSPORT_DISCOVERY_URL=https://passport.aetherpro.us/realms/syndicate/protocol/openid-connect/certs
# REDWATCH_BASE_URL=http://redwatch-harness:8787

# CORS (optional)
# CORS_ALLOWED_ORIGINS=http://localhost:33333
# CORS_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
